{
  "name": "@repo/ui-rnr",
  "private": true,
  "version": "0.1.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./components/*": {
      "types": "./src/components/*",
      "default": "./src/components/*"
    },
    "./lib/*": {
      "types": "./src/lib/*",
      "default": "./src/lib/*"
    },
    "./hooks/*": {
      "types": "./src/hooks/*",
      "default": "./src/hooks/*"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rn-primitives/accordion": "*",
    "@rn-primitives/alert-dialog": "*",
    "@rn-primitives/aspect-ratio": "*",
    "@rn-primitives/avatar": "*",
    "@rn-primitives/checkbox": "*",
    "@rn-primitives/collapsible": "*",
    "@rn-primitives/context-menu": "*",
    "@rn-primitives/dialog": "*",
    "@rn-primitives/dropdown-menu": "*",
    "@rn-primitives/hover-card": "*",
    "@rn-primitives/label": "*",
    "@rn-primitives/menubar": "*",
    "@rn-primitives/navigation-menu": "*",
    "@rn-primitives/popover": "*",
    "@rn-primitives/portal": "^1.3.0",
    "@rn-primitives/progress": "*",
    "@rn-primitives/radio-group": "*",
    "@rn-primitives/select": "*",
    "@rn-primitives/separator": "*",
    "@rn-primitives/slot": "*",
    "@rn-primitives/switch": "*",
    "@rn-primitives/table": "*",
    "@rn-primitives/tabs": "*",
    "@rn-primitives/toggle": "*",
    "@rn-primitives/toggle-group": "*",
    "@rn-primitives/tooltip": "*",
    "@rn-primitives/types": "*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react-native": "*",
    "react-native-reanimated": ">=4.0.0",
    "react-native-screens": ">=4.0.0",
    "react-native-svg": "*",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@repo/config-eslint": "workspace:*",
    "@repo/config-prettier": "workspace:*",
    "@repo/config-typescript": "workspace:*",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "prettier": "^3.6.2",
    "typescript": "^5"
  },
  "peerDependencies": {
    "nativewind": ">=4.0.0",
    "react": "^19.0.0",
    "react-native": ">=0.74.0"
  }
}
