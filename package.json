{
  "name": "project-online",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint --",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,md,json}\"",
    "check-types": "turbo run check-types",
    "prepare": "husky install"
  },
  "lint-staged": {
    "**/*.{js,ts,tsx}": [
      "pnpm run format",
      "pnpm run lint"
    ],
    "*.json": [
      "pnpm run format"
    ]
  },
  "devDependencies": {
    "@repo/prettier-config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "5.9.2",
    "eslint": "^9"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
