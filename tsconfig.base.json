{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "declaration": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@repo/core/*": ["libs/core/src/*"],
      "@repo/utils/*": ["libs/utils/src/*"],
      "@repo/store/*": ["libs/store/src/*"],
      "@repo/services/*": ["libs/services/src/*"],
      "@repo/brand/*": ["libs/brand/src/*"],
      "@repo/ui-shadcn/*": ["libs/ui/shadcn/src/*"],
      "@repo/ui-rnr/*": ["libs/ui/rnr/src/*"],
      "@repo/config-eslint/*": ["libs/config/eslint/*"],
      "@repo/config-prettier/*": ["libs/config/prettier/*"]
    },
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "exclude": ["node_modules", "dist", ".next"]
}
