{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "declaration": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@repo/core": ["libs/core/src"],
      "@repo/core/*": ["libs/core/src/*"],
      "@repo/utils": ["libs/utils/src"],
      "@repo/utils/*": ["libs/utils/src/*"],
      "@repo/store": ["libs/store/src"],
      "@repo/store/*": ["libs/store/src/*"],
      "@repo/services": ["libs/services/src"],
      "@repo/services/*": ["libs/services/src/*"],
      "@repo/features": ["libs/features/src"],
      "@repo/features/*": ["libs/features/src/*"],
      "@repo/eslint-config": ["libs/eslint-config"],
      "@repo/eslint-config/*": ["libs/eslint-config/*"],
      "@repo/prettier-config": ["libs/prettier-config"],
      "@repo/prettier-config/*": ["libs/prettier-config/*"],
      "@repo/typescript-config": ["libs/typescript-config"],
      "@repo/typescript-config/*": ["libs/typescript-config/*"]
    },
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "exclude": ["node_modules", "dist", ".next"]
}
