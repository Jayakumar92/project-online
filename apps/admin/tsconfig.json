{
  "extends": ["@repo/typescript-config/nextjs.json", "../../tsconfig.base.json"],
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@repo/core/*": ["../../packages/core/dist/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.js",
    ".next/types/**/*.ts",
    "globals.d.ts"
  ],
  "exclude": ["node_modules"]
}
