{
  "extends": ["@repo/typescript-config/nextjs.json", "../../tsconfig.base.json"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@repo/core": ["../../libs/core/src"],
      "@repo/core/*": ["../../libs/core/src/*"],
      "@repo/store": ["../../libs/store/src"],
      "@repo/store/*": ["../../libs/store/src/*"],
      "@repo/utils": ["../../libs/utils/src"],
      "@repo/utils/*": ["../../libs/utils/src/*"],
      "@repo/services": ["../../libs/services/src"],
      "@repo/services/*": ["../../libs/services/src/*"],
      "@repo/features": ["../../libs/features/src"],
      "@repo/features/*": ["../../libs/features/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.js",
    ".next/types/**/*.ts",
    "globals.d.ts"
  ],
  "exclude": ["node_modules"]
}
