#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Disable interactive prompts during git hooks
export CI=true

echo "🔍 Running pre-commit checks..."

echo "🔎 Running type check on affected projects..."
pnpm nx affected --target=typecheck || {
  echo "❌ Type check failed. Please fix type errors before committing."
  exit 1
}

echo "✨ Running lint-staged (format & lint staged files)..."
pnpm lint-staged || {
  echo "❌ Lint-staged failed. Please fix the issues above."
  exit 1
}

echo "✅ All pre-commit checks passed!"
